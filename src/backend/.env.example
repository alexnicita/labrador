# Local development only. Do not commit a real .env file.
PORT=4001
HOST=0.0.0.0
RUST_LOG=labrador_realtime=debug,tower_http=info

# Comma-separated browser origins allowed to open WebSocket connections.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set this only for local manual testing. Production should use REALTIME_AUTH_JWT_SECRET.
LABRADOR_DEV_AUTH_BYPASS=true

# Railway production variable. Keep the real value in Railway variables or a secret store,
# not in git.
# REALTIME_AUTH_JWT_SECRET=replace-with-a-long-random-secret

# Optional server-to-server publish token for trusted HTTP fanout from the Next.js API
# after durable message/comment/run mutations commit.
# REALTIME_PUBLISH_SECRET=replace-with-a-different-long-random-secret

# Realtime scaling and backpressure defaults. Tune per Railway service size.
MAX_CONNECTIONS=10000
MAX_ROOM_CONNECTIONS=10000
ROOM_BROADCAST_CAPACITY=4096
ROOM_REPLAY_CAPACITY=1024
OUTBOUND_QUEUE_CAPACITY=256
MAX_WS_MESSAGE_BYTES=65536
MAX_EVENT_PAYLOAD_BYTES=49152
MAX_PRESENCE_FOCUS_BYTES=512
PRESENCE_EVENTS_PER_SECOND=8
PRESENCE_BURST=24
MUTATION_EVENTS_PER_SECOND=20
MUTATION_BURST=40
PING_INTERVAL_SECS=25
